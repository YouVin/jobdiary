{
  "name": "jobdiary-monorepo",
  "private": true,
  "workspaces": ["apps/web", "apps/extension"],
  "engines": { "node": ">=22.12.0", "npm": ">=11" },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=jobdiary",
    "dev:extension": "npm run dev --workspace=jobdiary-extension",
    "start": "npm run start --workspace=jobdiary",
    "lint": "npm run lint --workspace=jobdiary",
    "check:ui": "npm run check:ui --workspace=jobdiary",
    "test": "npm run test:web && npm run test:extension",
    "test:web": "npm test --workspace=jobdiary",
    "test:extension": "npm test --workspace=jobdiary-extension",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "npm run build --workspace=jobdiary",
    "build:extension": "npm run build --workspace=jobdiary-extension"
  }
}
